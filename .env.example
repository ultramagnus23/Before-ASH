# ─── Supabase ────────────────────────────────────────────────────────────
# Project Settings -> API. The anon key is safe for the browser; the
# service role key is NEVER prefixed NEXT_PUBLIC_ and never sent to a
# client bundle (next.config.ts fails the build if it is).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings -> Database -> Connection string (use the pooled
# "Transaction" mode string for the app, the direct string for migrations
# if your plan requires it).
DATABASE_URL=

# ─── Auth ────────────────────────────────────────────────────────────────
ALLOWED_EMAIL_DOMAIN=ashoka.edu.in
ADMIN_HANDLES=your_handle_here

# ─── Open-source LLM (no Anthropic/OpenAI/any closed model — see
# BUILD-PROMPT.md #14.1). Point at your own Ollama instance or any
# OpenAI-compatible endpoint serving an open-weight model. callModel() only
# ever sends { task, text } to this endpoint — never a user id, item id,
# handle, or email. ────────────────────────────────────────────────────
# The wire format is OpenAI-compatible (/chat/completions, /embeddings),
# which every hosted open-weights provider speaks and which Ollama also
# serves on its /v1 path. LLM_API_URL must therefore include the version
# prefix. Examples:
#
#   Local Ollama    LLM_API_URL=http://localhost:11434/v1     (no key)
#   Hosted provider LLM_API_URL=https://<host>/openai/v1      (key required)
#
# IMPORTANT: a localhost URL cannot work on Vercel — "localhost" there is
# the serverless function itself. Production needs a reachable host, or
# moderation fails closed on every publication and search silently drops to
# keyword matching. Check /api/health/inference after deploying.
LLM_API_URL=http://localhost:11434/v1
LLM_MODEL_NAME=llama3.1:8b
LLM_EMBEDDING_MODEL_NAME=nomic-embed-text
# Optional: omit for a local endpoint that needs no auth.
LLM_API_KEY=
# Optional: defaults to openai-compatible, the only provider implemented.
LLM_PROVIDER=openai-compatible
# Optional: per-call timeout in ms, default 15000.
LLM_TIMEOUT_MS=15000
AI_ENABLED=true

# ─── Anonymous review (see BUILD-PROMPT.md #14) ─────────────────────────
# Set to false during exam/paper crunch weeks — the anonymous checkbox
# disappears from the composer, named posting is unaffected, and anything
# already queued still gets reviewed once you flip it back on.
ANON_REVIEW_ENABLED=true

# ─── Rate limiting ───────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── App ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
POLICY_VERSION=2026-08-22

# Random secret, set as a Vercel env var. Vercel Cron sends this as
# `Authorization: Bearer <value>` when it calls /api/cron/purge-accounts —
# without it matching, the route refuses to run.
CRON_SECRET=
